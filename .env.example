# =========================================================================
# VELQORA / KARWAN ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and fill in your actual production credentials
# =========================================================================

# Firebase Client Configuration (Vite)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Telephony Configuration
VOICE_PROVIDER=mock
TOLL_FREE_NUMBER=1800-86551234
EXOTEL_PHONE_NUMBER=1800-86551234
OPERATOR_PHONE_NUMBER=8655123452

# Exotel Credentials
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_BASE_URL=https://api.in.exotel.com
EXOTEL_FLOW_URL=

VOICE_DEFAULT_LANGUAGE=hi
VOICE_CALLBACK_ENABLED=true
VOICE_CALLBACK_COOLDOWN_MINUTES=10
VOICE_SERVER_PORT=4000

